--- a/MdeModulePkg/Core/Dxe/DxeMain/DxeMain.c
+++ b/MdeModulePkg/Core/Dxe/DxeMain/DxeMain.c
@@ -550,6 +550,21 @@
   //
   // Invoke the DXE Dispatcher
   //
+#if ENUMA_DIAG_STAGE == 10
+  //
+  // R-008/A: read the display window before any DXE driver is dispatched.
+  // The R-004 device mapping is already installed here, so a stall cannot be
+  // blamed on an unmapped address; it means the domain really is not
+  // reachable. A clean return means the domain was still up when we took
+  // control, and the teardown then happens inside our own dispatch.
+  //
+  {
+    volatile UINT32 EnumaDxeDisplayProbe0 = *(volatile UINT32 *)0x0ae6b800U;
+    volatile UINT32 EnumaDxeDisplayProbe1 = *(volatile UINT32 *)0x0ae6c000U;
+    (VOID) EnumaDxeDisplayProbe0;
+    (VOID) EnumaDxeDisplayProbe1;
+  }
+#endif
   EnumaStageCheckpoint (10);
   CoreDispatcher ();
 
