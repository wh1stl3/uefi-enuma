--- a/Silicon/Silicium/SiliciumPkg/Drivers/SimpleFbDxe/SimpleFb.c
+++ b/Silicon/Silicium/SiliciumPkg/Drivers/SimpleFbDxe/SimpleFb.c
@@ -392,7 +392,29 @@
   Status = CreateFrameBufferConfig (BaseAddress);
   if (EFI_ERROR (Status)) {
     goto cleanup;
   }
 
+#if ENUMA_DIAG_GOP_STEP > 0 && ENUMA_DIAG_GOP_STEP < 8
+  {
+    //
+    // R-008: carry one display register value out through the reset delay.
+    // The read happens here, inside the driver, because this is the only
+    // context where the SDE registers have been observed to be readable; the
+    // same read from the stage checkpoint hangs the bus. One second per
+    // nibble step, so the host recovers the value from the return time.
+    //
+    STAT CONST UINTN ProbeAddress[7] = {
+      0x0ae00000U, 0x0ae05014U, 0x0ae07014U, 0x0ae09014U,
+      0x0ae0b014U, 0x0ae25014U, 0x0ae27014U
+    };
+    UINT32 Nibble;
+    (VOID)*(volatile UINT32 *)0x0ae6b800U;
+    Nibble = ((*(volatile UINT32 *)ProbeAddress[ENUMA_DIAG_GOP_STEP - 1]) >> 4) & 0x0fU;
+    gBS->Stall (2000000U + (Nibble * 1000000U));
+    gBS->ResetSystem (EfiResetCold, EFI_SUCCESS, 0, NULL);
+    CpuDeadLoop ();
+  }
+#endif
+
   // Register GOP Protocol
   Status = gBS->InstallMultipleProtocolInterfaces (&ImageHandle, &gEfiDevicePathProtocolGuid, &DisplayDevicePath, &gEfiGraphicsOutputProtocolGuid, &mFrameBuffer, NULL);
